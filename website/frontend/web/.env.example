# Website environment (frontend/web). Copy to `.env.local` (git-ignored). Validated at startup by lib/env.ts.
# Only NEXT_PUBLIC_* values reach the browser. No secrets here.

# API base URL used in the browser (client components). No trailing slash.
# When NEXT_PUBLIC_APP_ENV=production, both public URLs must be real HTTPS origins, not localhost/example hosts.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# API base URL used by server components and route handlers (may be an internal host). Falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=http://localhost:4000/api/v1
# Canonical origin of the website (canonicals, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1 = every server fetch uses revalidate 0, so dashboard edits show immediately (development only).
NEXT_PUBLIC_DEV_NO_CACHE=
# Extra hosts allowed by the image optimiser, comma-separated (the API host is added automatically).
NEXT_IMAGE_REMOTE_HOSTS=
# Optional: privacy-friendly analytics (both empty = disabled) and error reporting DSN (empty = console only).
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ERROR_DSN=
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_BUILD_ID=dev
