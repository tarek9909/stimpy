{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2efull-20261004/types/**/*.ts",
    ".next-e2efull-clean-20261004/types/**/*.ts",
    ".next-e2efull-corrected-20261004/types/**/*.ts",
    ".next-e2efull-impacted-20261004/types/**/*.ts",
    ".next-e2efull-snapshot-20261004/types/**/*.ts",
    ".next-e2efull-snapshot2-20261004/types/**/*.ts",
    ".next-fw2/types/**/*.ts",
    ".next-fw2dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-e2efull-impacted2-20261004/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
