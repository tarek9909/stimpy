# Stimpy dashboard (frontend/admin). Only non-secret values: everything VITE_* is bundled and public.
# API base URL. Must allow credentialed CORS from this dashboard's origin (API: ADMIN_URL).
# Use `localhost`, never 127.0.0.1 (the session cookie is host-only).
VITE_API_URL=http://localhost:4000/api/v1
# Public website origin, for "View on website" links.
# When VITE_APP_ENV=production, both public URLs must be real HTTPS origins, not localhost/example hosts.
VITE_SITE_URL=http://localhost:3000
# local | staging | production
VITE_APP_ENV=local
# Fallback IANA zone until business.timezone has loaded. The business setting wins.
VITE_DEFAULT_TIMEZONE=Asia/Beirut
# New-order poll interval (ms). Spec: 30000.
VITE_ORDER_POLL_INTERVAL_MS=30000
