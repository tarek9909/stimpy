{
  "name": "@stimpy/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:restart-safety": "tsx scripts/restart-safety-probe.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:link-subscribers": "tsx scripts/link-subscribers.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "contract:check": "tsx scripts/contract-check.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
