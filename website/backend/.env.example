# Stimpy API configuration. Copy to `.env` (git-ignored). Validated at startup (src/config.ts);
# the process refuses to start on a missing or invalid value. Real environment variables win over this file.

# development | test | production
NODE_ENV=development

# Where the API listens.
PORT=4000
HOST=0.0.0.0

# MySQL connection. Production rejects localhost, the sample password, and database names containing dev/test/local markers.
# Private database hosts (for example a Compose service name) are allowed.
DATABASE_URL=mysql://stimpy:stimpy@localhost:3317/stimpy
# Database used by `npm run api:test` (it is wiped between tests: its name MUST contain "test").
TEST_DATABASE_URL=mysql://stimpy:stimpy@localhost:3317/stimpy_test

# Public site origin(s): CORS and email links. Comma-separated; the first entry is used for email links.
# Production requires HTTPS and rejects localhost/example hosts.
WEB_URL=http://localhost:3000
# Dashboard origin(s): CORS with credentials and the Origin check. Comma-separated, e.g.
# http://localhost:5173,http://192.168.1.20:5173 for phone testing. Cookie Domain is left unset (host-only).
# Production requires HTTPS and rejects localhost/example hosts.
ADMIN_URL=http://localhost:5173
# Absolute URLs of uploaded files are built from this. Production requires a public HTTPS URL.
API_PUBLIC_URL=http://localhost:4000

# SMTP (Mailpit locally). Production rejects localhost and Mailpit; configure a real provider.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Local file storage (relative paths are resolved against backend).
UPLOAD_DIR=./uploads

# Must be true when served over HTTPS (production refuses to start with false).
COOKIE_SECURE=false

# Used only by `npm run db:seed` and `npm run admin:create` (password >= 12 characters).
ADMIN_EMAIL=owner@stimpy.local
ADMIN_PASSWORD=Stimpy-Dev-Password-1

# --- Optional extras (not in the backend README table) ---
# trace | debug | info | warn | error | fatal | silent  (default: info, silent in test)
LOG_LEVEL=info
# true (= 1 hop) when running behind ONE reverse proxy that appends X-Forwarded-For; a number for several proxies
TRUST_PROXY=false
# true to not start the background timers (email worker, hold expiry, session cleanup)
DISABLE_JOBS=false
# Mailpit HTTP API, used by tests
MAILPIT_URL=http://localhost:8025
