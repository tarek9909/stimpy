// Stimpy database schema. Source of truth: docs/website/backend/data-model.md (+ open-questions.md amendments).
// Conventions: snake_case tables/columns, UNSIGNED INT ids, money in INT cents, DATETIME(3) UTC, no soft delete.
// CHECK constraints (quantity/reserved) cannot be expressed in Prisma; they live in the migration SQL
// (see prisma/migrations/*_init/migration.sql, section "CHECK constraints").

generator client {
  provider = "prisma-client-js"
  output   = "../../.tmp-prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderSource {
  WEBSITE
  INSTAGRAM
  WHATSAPP
  MANUAL
}

enum OrderItemKind {
  PACK
  HOODIE
  STIMPIE
}

enum StimpieType {
  CORE
  LIMITED
}

enum AccentColor {
  BUTTER
  SKY
  LILAC
}

enum StockItemType {
  HOODIE_VARIANT
  STIMPIE
}

enum StockField {
  QUANTITY
  RESERVED
}

enum StockReason {
  INITIAL
  RESTOCK
  CORRECTION
  DAMAGED
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_SOLD
  ORDER_RETURNED
  ORDER_WRITTEN_OFF
}

enum StockLineState {
  RESERVED
  SOLD
  RELEASED
  RESTOCKED
  WRITTEN_OFF
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriberType {
  EMAIL
  WHATSAPP
}

enum UserRole {
  OWNER
  PACKER
}

// ---------------------------------------------------------------- people / auth

model AdminUser {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(120)
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sessions          AdminSession[]
  orderEvents       OrderEvent[]
  orderNotes        OrderNote[]
  stockMovements    StockMovement[]
  uploads           Upload[]
  customerFollowUps CustomerFollowUp[]
  customerNotes     CustomerNote[]

  @@map("admin_users")
}

model AdminSession {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  userId            Int      @map("user_id") @db.UnsignedInt
  tokenHash         String   @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime @map("expires_at") @db.DateTime(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.DateTime(3)
  lastUsedAt        DateTime @map("last_used_at") @db.DateTime(3)
  userAgent         String?  @map("user_agent") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("admin_sessions")
}

// ---------------------------------------------------------------- catalog / configuration

model Color {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  name           String   @unique @db.VarChar(60)
  hex            String   @db.Char(7)
  position       Int      @default(0)
  active         Boolean  @default(true)
  images         Json
  builderTint    String?  @map("builder_tint") @db.Char(7)
  builderTexture String?  @map("builder_texture") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  variants HoodieVariant[]

  @@map("colors")
}

model Size {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  label     String   @unique @db.VarChar(20)
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  variants    HoodieVariant[]
  chartValues SizeChartValue[]

  @@map("sizes")
}

model SizeChartColumn {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  label     String   @db.VarChar(40)
  unit      String   @db.VarChar(10)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  values SizeChartValue[]

  @@map("size_chart_columns")
}

model SizeChartValue {
  id       Int    @id @default(autoincrement()) @db.UnsignedInt
  sizeId   Int    @map("size_id") @db.UnsignedInt
  columnId Int    @map("column_id") @db.UnsignedInt
  value    String @db.VarChar(30)

  size   Size            @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  column SizeChartColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([sizeId, columnId])
  @@index([columnId])
  @@map("size_chart_values")
}

model Hoodie {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String   @db.Text
  details     Json
  priceCents  Int      @map("price_cents")
  costCents   Int      @default(1000) @map("cost_cents")
  images      Json
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  variants HoodieVariant[]

  @@map("hoodies")
}

model HoodieVariant {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  hoodieId  Int      @map("hoodie_id") @db.UnsignedInt
  colorId   Int      @map("color_id") @db.UnsignedInt
  sizeId    Int      @map("size_id") @db.UnsignedInt
  sku       String   @unique @db.VarChar(60)
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  hoodie Hoodie @relation(fields: [hoodieId], references: [id], onDelete: Restrict)
  color  Color  @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size   Size   @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  stockLines     OrderStockLine[]
  stockMovements StockMovement[]

  @@unique([hoodieId, colorId, sizeId])
  @@index([colorId])
  @@index([sizeId])
  @@map("hoodie_variants")
}

model Drop {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  name        String      @db.VarChar(120)
  slug        String      @unique @db.VarChar(140)
  story       String      @db.Text
  accentColor AccentColor @map("accent_color")
  startsAt    DateTime    @map("starts_at") @db.DateTime(3)
  endsAt      DateTime?   @map("ends_at") @db.DateTime(3)
  endedAt     DateTime?   @map("ended_at") @db.DateTime(3)
  teaserImage String?     @map("teaser_image") @db.VarChar(500)
  teaserVideo String?     @map("teaser_video") @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  stimpies    Stimpie[]
  subscribers Subscriber[]

  @@index([startsAt])
  @@map("drops")
}

model Stimpie {
  id            Int         @id @default(autoincrement()) @db.UnsignedInt
  name          String      @db.VarChar(120)
  slug          String      @unique @db.VarChar(140)
  type          StimpieType
  dropId        Int?        @map("drop_id") @db.UnsignedInt
  priceCents    Int         @map("price_cents")
  costCents     Int         @map("cost_cents")
  quantity      Int         @default(0)
  reserved      Int         @default(0)
  story         String      @db.Text
  images        Json
  artworkUrl    String      @map("artwork_url") @db.VarChar(500)
  artworkWidth  Int?        @map("artwork_width")
  artworkHeight Int?        @map("artwork_height")
  active        Boolean     @default(true)
  position      Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  drop Drop? @relation(fields: [dropId], references: [id], onDelete: Restrict)

  stockLines     OrderStockLine[]
  stockMovements StockMovement[]

  @@index([dropId])
  @@index([type, active, position])
  @@map("stimpies")
}

model Pack {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(140)
  description  String   @db.Text
  stimpieCount Int      @map("stimpie_count")
  priceCents   Int      @map("price_cents")
  badge        String?  @db.VarChar(40)
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("packs")
}

model Area {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @unique @db.VarChar(120)
  feeCents  Int?     @map("fee_cents")
  estDays   Int?     @map("est_days")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customers Customer[]
  orders    Order[]

  @@map("areas")
}

model Upload {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  path         String   @unique @db.VarChar(300)
  url          String   @db.VarChar(500)
  mime         String   @db.VarChar(80)
  sizeBytes    Int      @map("size_bytes")
  width        Int?
  height       Int?
  originalName String   @map("original_name") @db.VarChar(200)
  createdBy    Int?     @map("created_by") @db.UnsignedInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  creator AdminUser? @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@map("uploads")
}

// ---------------------------------------------------------------- orders and stock

model Customer {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  phone             String    @unique @db.VarChar(20)
  whatsapp          String    @db.VarChar(20)
  name              String    @db.VarChar(120)
  email             String?   @db.VarChar(190)
  areaId            Int?      @map("area_id") @db.UnsignedInt
  notes             String?   @db.Text
  /// Set when the person asked to stop receiving bulk email/WhatsApp messages. Bulk sends skip them (server-side).
  marketingOptOutAt DateTime? @map("marketing_opt_out_at") @db.DateTime(3)
  emailConsent      Boolean   @default(false) @map("email_consent")
  whatsappConsent   Boolean   @default(false) @map("whatsapp_consent")
  consentUpdatedAt  DateTime? @map("consent_updated_at") @db.DateTime(3)
  unsubscribedAt    DateTime? @map("unsubscribed_at") @db.DateTime(3)
  unsubscribeToken  String?   @unique @map("unsubscribe_token") @db.Char(64)
  firstSource       String?   @map("first_source") @db.VarChar(80)
  firstUtmSource    String?   @map("first_utm_source") @db.VarChar(80)
  firstUtmMedium    String?   @map("first_utm_medium") @db.VarChar(80)
  firstUtmCampaign  String?   @map("first_utm_campaign") @db.VarChar(80)
  firstUtmContent   String?   @map("first_utm_content") @db.VarChar(80)
  firstUtmTerm      String?   @map("first_utm_term") @db.VarChar(80)
  firstReferrer     String?   @map("first_referrer") @db.VarChar(500)
  firstTouchAt      DateTime? @map("first_touch_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  area        Area?              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  orders      Order[]
  followUps   CustomerFollowUp[]
  tags        CustomerTagLink[]
  notesList   CustomerNote[]
  subscribers Subscriber[]

  @@index([email])
  @@index([areaId])
  @@map("customers")
}

model Order {
  id                 Int         @id @default(autoincrement()) @db.UnsignedInt
  number             String      @unique @db.VarChar(30)
  customerId         Int         @map("customer_id") @db.UnsignedInt
  status             OrderStatus
  source             OrderSource
  customerName       String      @map("customer_name") @db.VarChar(120)
  contactEmail       String?     @map("contact_email") @db.VarChar(190)
  contactPhone       String      @map("contact_phone") @db.VarChar(20)
  contactWhatsapp    String      @map("contact_whatsapp") @db.VarChar(20)
  areaId             Int?        @map("area_id") @db.UnsignedInt
  areaName           String      @map("area_name") @db.VarChar(120)
  address            String      @db.Text
  notes              String?     @db.Text
  subtotalCents      Int         @map("subtotal_cents")
  deliveryFeeCents   Int         @map("delivery_fee_cents")
  totalCents         Int         @map("total_cents")
  costCents          Int         @map("cost_cents")
  cashCollected      Boolean     @default(false) @map("cash_collected")
  cashSettled        Boolean     @default(false) @map("cash_settled")
  deliveryNumber     String?     @map("delivery_number") @db.VarChar(60)
  placedAt           DateTime    @default(now()) @map("placed_at") @db.DateTime(3)
  holdExpiresAt      DateTime?   @map("hold_expires_at") @db.DateTime(3)
  confirmedAt        DateTime?   @map("confirmed_at") @db.DateTime(3)
  outForDeliveryAt   DateTime?   @map("out_for_delivery_at") @db.DateTime(3)
  deliveredAt        DateTime?   @map("delivered_at") @db.DateTime(3)
  cancelledAt        DateTime?   @map("cancelled_at") @db.DateTime(3)
  cancelReason       String?     @map("cancel_reason") @db.VarChar(255)
  idempotencyKey     String?     @unique @map("idempotency_key") @db.VarChar(80)
  idempotencyHash    String?     @map("idempotency_hash") @db.Char(64)
  requestFingerprint String?     @map("request_fingerprint") @db.VarChar(64)
  utmSource          String?     @map("utm_source") @db.VarChar(80)
  utmMedium          String?     @map("utm_medium") @db.VarChar(80)
  utmCampaign        String?     @map("utm_campaign") @db.VarChar(80)
  utmContent         String?     @map("utm_content") @db.VarChar(80)
  utmTerm            String?     @map("utm_term") @db.VarChar(80)
  referrer           String?     @db.VarChar(500)
  createdAt          DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  area     Area?    @relation(fields: [areaId], references: [id], onDelete: Restrict)

  items          OrderItem[]
  stockLines     OrderStockLine[]
  events         OrderEvent[]
  notesList      OrderNote[]
  emails         EmailLog[]
  stockMovements StockMovement[]

  @@index([status, placedAt])
  @@index([customerId])
  @@index([contactPhone])
  @@index([contactEmail])
  @@index([deliveryNumber])
  @@index([areaId])
  @@index([deliveredAt])
  @@map("orders")
}

model OrderItem {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  orderId        Int           @map("order_id") @db.UnsignedInt
  kind           OrderItemKind
  name           String        @db.VarChar(160)
  qty            Int
  unitPriceCents Int           @map("unit_price_cents")
  unitCostCents  Int           @map("unit_cost_cents")
  detail         Json
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockLines OrderStockLine[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStockLine {
  id          Int            @id @default(autoincrement()) @db.UnsignedInt
  orderId     Int            @map("order_id") @db.UnsignedInt
  orderItemId Int            @map("order_item_id") @db.UnsignedInt
  itemType    StockItemType  @map("item_type")
  variantId   Int?           @map("variant_id") @db.UnsignedInt
  stimpieId   Int?           @map("stimpie_id") @db.UnsignedInt
  qty         Int
  state       StockLineState @default(RESERVED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variant   HoodieVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stimpie   Stimpie?       @relation(fields: [stimpieId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([variantId])
  @@index([stimpieId])
  @@map("order_stock_lines")
}

model OrderEvent {
  id         Int          @id @default(autoincrement()) @db.UnsignedInt
  orderId    Int          @map("order_id") @db.UnsignedInt
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  userId     Int?         @map("user_id") @db.UnsignedInt
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  AdminUser? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([userId])
  @@map("order_events")
}

model OrderNote {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  orderId   Int      @map("order_id") @db.UnsignedInt
  userId    Int      @map("user_id") @db.UnsignedInt
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  AdminUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
  @@map("order_notes")
}

model CustomerFollowUp {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  customerId Int       @map("customer_id") @db.UnsignedInt
  userId     Int       @map("user_id") @db.UnsignedInt
  dueAt      DateTime  @map("due_at") @db.DateTime(3)
  note       String    @db.VarChar(1000)
  doneAt     DateTime? @map("done_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user     AdminUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([doneAt, dueAt])
  @@index([customerId, createdAt])
  @@map("customer_follow_ups")
}

model CustomerTag {
  id        Int               @id @default(autoincrement()) @db.UnsignedInt
  name      String            @unique @db.VarChar(80)
  color     String?           @db.VarChar(20)
  createdAt DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  customers CustomerTagLink[]

  @@map("customer_tags")
}

model CustomerTagLink {
  customerId Int         @map("customer_id") @db.UnsignedInt
  tagId      Int         @map("tag_id") @db.UnsignedInt
  createdAt  DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId, customerId])
  @@map("customer_tag_links")
}

model CustomerNote {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  customerId Int       @map("customer_id") @db.UnsignedInt
  userId     Int       @map("user_id") @db.UnsignedInt
  body       String    @db.VarChar(2000)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

model StockMovement {
  id        Int           @id @default(autoincrement()) @db.UnsignedInt
  itemType  StockItemType @map("item_type")
  variantId Int?          @map("variant_id") @db.UnsignedInt
  stimpieId Int?          @map("stimpie_id") @db.UnsignedInt
  field     StockField
  delta     Int
  reason    StockReason
  orderId   Int?          @map("order_id") @db.UnsignedInt
  userId    Int?          @map("user_id") @db.UnsignedInt
  note      String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  variant HoodieVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stimpie Stimpie?       @relation(fields: [stimpieId], references: [id], onDelete: Restrict)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user    AdminUser?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([stimpieId, createdAt])
  @@index([orderId])
  @@index([userId])
  @@map("stock_movements")
}

model Counter {
  name  String @id @db.VarChar(40)
  value Int

  @@map("counters")
}

// ---------------------------------------------------------------- people, money, comms, content

model Subscriber {
  id         Int            @id @default(autoincrement()) @db.UnsignedInt
  contact    String         @db.VarChar(190)
  type       SubscriberType
  dropId     Int?           @map("drop_id") @db.UnsignedInt
  customerId Int?           @map("customer_id") @db.UnsignedInt
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  drop     Drop?     @relation(fields: [dropId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Uniqueness of (contact, drop_id) is enforced in the service: MySQL treats NULLs as distinct in unique indexes.
  @@index([contact, dropId])
  @@index([dropId])
  @@index([customerId])
  @@map("subscribers")
}

model Expense {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  category    String   @db.VarChar(60)
  amountCents Int      @map("amount_cents")
  note        String?  @db.VarChar(255)
  spentOn     DateTime @map("spent_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([spentOn])
  @@map("expenses")
}

model AdSpend {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  channel     String   @db.VarChar(60)
  amountCents Int      @map("amount_cents")
  note        String?  @db.VarChar(255)
  spentOn     DateTime @map("spent_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([spentOn])
  @@map("ad_spend")
}

model EmailTemplate {
  key       String   @id @db.VarChar(60)
  name      String   @db.VarChar(100)
  subject   String   @db.VarChar(200)
  body      String   @db.Text
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("email_templates")
}

model WhatsappTemplate {
  key       String   @id @db.VarChar(60)
  name      String   @db.VarChar(100)
  body      String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("whatsapp_templates")
}

model EmailLog {
  id            Int         @id @default(autoincrement()) @db.UnsignedInt
  orderId       Int?        @map("order_id") @db.UnsignedInt
  toEmail       String      @map("to_email") @db.VarChar(190)
  templateKey   String      @map("template_key") @db.VarChar(60)
  subject       String      @db.VarChar(250)
  bodyText      String      @map("body_text") @db.MediumText
  bodyHtml      String      @map("body_html") @db.MediumText
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.DateTime(3)
  error         String?     @db.VarChar(500)
  sentAt        DateTime?   @map("sent_at") @db.DateTime(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@map("email_log")
}

model Faq {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  question   String   @db.VarChar(200)
  answer     String   @db.Text
  group      String?  @db.VarChar(60)
  showOnHome Boolean  @default(false) @map("show_on_home")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("faqs")
}

model Review {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @db.VarChar(120)
  text      String   @db.Text
  mediaUrl  String?  @map("media_url") @db.VarChar(500)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("reviews")
}

model ContentBlock {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("content_blocks")
}

model Setting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("settings")
}

model BuilderConfig {
  key       String   @id @db.VarChar(40)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("builder_config")
}
