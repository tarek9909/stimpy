.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/

# Dependencies
node_modules/
**/node_modules/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Build & Vite artifacts
dist/
**/dist/
.vite/
